# --- OpenAI (OBLIGATORIO) -------------------------------------------------
# La clave vive SOLO en el servidor. Nunca la pongas en la app iOS.
OPENAI_API_KEY=
# Elige modelos vigentes en https://platform.openai.com/docs/models
# (el modelo de texto debe aceptar imágenes de entrada en la Responses API).
# Ejemplos tomados del SDK openai==3.55.1 (verifícalos antes de usarlos):
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
# Opcional, sólo si el modelo admite razonamiento configurable: low | medium | high
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=16000

# --- Dispositivos autorizados (OBLIGATORIO) -------------------------------
# Genera cada token con: python scripts/new_token.py
API_TOKENS=

# --- Almacenamiento y privacidad -----------------------------------------
DATA_DIR=/data
DELETE_UPLOADS_AFTER_PROCESSING=true
RESULT_RETENTION_HOURS_AFTER_ACK=24
UNACKED_RESULT_RETENTION_HOURS=168

# --- Límites ---------------------------------------------------------------
MAX_IMAGES_PER_JOB=6
MAX_UPLOAD_MB=12
MAX_JOBS_PER_DAY=60
MAX_IMAGES_PER_DAY=200
MAX_GENERATED_IMAGES_PER_JOB=2

# --- HTTPS -----------------------------------------------------------------
# true detrás de Caddy/nginx (que envía X-Forwarded-Proto: https)
REQUIRE_HTTPS=true

# --- APNs (opcional, cuenta Apple Developer de pago) -------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=/run/secrets/apns_key.p8
# El entorno (sandbox/production) lo informa cada iPhone al registrarse:
# las builds Debug instaladas desde Xcode usan sandbox.
APNS_ALERT_DELAY_SECONDS=120
